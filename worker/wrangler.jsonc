{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streak-king-parse",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  // per-IP ceiling; a person typing triggers at most one call per pause
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
